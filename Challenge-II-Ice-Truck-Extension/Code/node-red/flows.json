  {
    "id": "fn_format",
    "type": "function",
    "z": "tab1",
    "name": "Zeile -> MQTT-Topics (Track B)",
    "func": "var row = msg.payload && msg.payload[0];\nif (!row) {\n    return null;\n}\nvar base = \"team13-1/icetruck/\";\nvar msgs = [\n    { topic: base + \"sensors/sensor_board_raw\", payload: row.sensor_board_raw, retain: true },\n    { topic: base + \"sensors/sensor_board_temp_c\", payload: row.sensor_board_temp_c, retain: true },\n    { topic: base + \"sensors/sensor_board_digital\", payload: row.sensor_board_digital, retain: true },\n    { topic: base + \"sensors/actor_board_raw\", payload: row.actor_board_raw, retain: true },\n    { topic: base + \"sensors/actor_board_temp_c\", payload: row.actor_board_temp_c, retain: true },\n    { topic: base + \"actuators/fan_pwm\", payload: row.fan_pwm, retain: true },\n    { topic: base + \"actuators/valve_angle\", payload: row.valve_angle, retain: true },\n    { topic: base + \"status\", payload: JSON.stringify(row), retain: true }\n];\nreturn [msgs];",
    "outputs": 1,
    "x": 590,
    "y": 100,
    "wires": [["mqtt_out1"]]
  },
  {
    "id": "mqtt_out1",
    "type": "mqtt out",
    "z": "tab1",
    "name": "Publish team13-1/icetruck/*",
    "topic": "",
    "qos": "0",
    "retain": "",
    "broker": "broker1",
    "x": 850,
    "y": 100,
    "wires": []
  },
  {
    "id": "mqtt_in1",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Subscribe control/#",
    "topic": "team13-1/icetruck/control/#",
    "qos": "1",
    "datatype": "auto",
    "broker": "broker1",
    "x": 160,
    "y": 260,
    "wires": [["fn_validate"]]
  },
  {
    "id": "fn_validate",
    "type": "function",
    "z": "tab1",
    "name": "Validieren + loggen + I2C-Forwarding",
    "func": "var parts = msg.topic.split(\"/\");\nvar field = parts[3]; // \"mode\" | \"fan_pwm\" | \"valve_angle\"\nvar value = msg.payload;\n\nif (field === \"mode\") {\n    if (value !== \"auto\" && value !== \"manual\") {\n        node.warn(\"Ungueltiger mode: \" + value);\n        return null;\n    }\n} else if (field === \"fan_pwm\") {\n    value = Math.max(0, Math.min(255, parseInt(value, 10)));\n} else if (field === \"valve_angle\") {\n    value = Math.max(0, Math.min(180, parseInt(value, 10)));\n} else {\n    node.warn(\"Unbekanntes control-Topic: \" + msg.topic);\n    return null;\n}\n\n// Dritter Output: uebergibt \"field value\" als einen String an den exec1-\n// Node, der set_control.py (pi-backend/control_state.py) aufruft - dieser\n// schreibt control_state.json, das app.py (Challenge-I-Regelkreis) jeden\n// Poll-Zyklus liest und bei mode == \"manual\" statt der rules.py-Sollwerte\n// tatsaechlich per I2C an write_actor_setpoints() weiterreicht. Bewusst\n// EIN String statt [field, value]-Array: der Exec-Node haengt msg.payload\n// per String-Konkatenation an (arg += \" \" + value), ein Array wuerde dabei\n// zu \"field,value\" (ein Kommaseparierter String = EIN CLI-Arg statt zwei) -\n// set_control.py bekaeme dann nur ein Argument und bricht mit Usage-Error\n// ab (live auf dem Pi am 25.09. reproduziert und gefixt).\nvar record = { field: field, value: value, received_at: new Date().toISOString() };\nreturn [\n    { payload: record },\n    { payload: JSON.stringify(record) },\n    { payload: field + \" \" + String(value) }\n];",
    "outputs": 3,
    "x": 430,
    "y": 260,
    "wires": [["debug1"], ["file1"], ["exec1"]]
  },
  {
    "id": "debug1",
    "type": "debug",
