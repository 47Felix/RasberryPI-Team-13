[Unit]
Description=Challenge III Ice-Truck Cloud-Bridge (SQLite -> ThingSpeak / Azure IoT Hub)
After=network-online.target challenge-i-backend.service
Wants=network-online.target

[Service]
Type=simple
User=team13
WorkingDirectory=/home/team13/RasberryPI-Team-13/Challenge-III-Ice-Truck-Cloud/Code/cloud-bridge
EnvironmentFile=/home/team13/RasberryPI-Team-13/Challenge-III-Ice-Truck-Cloud/Code/cloud-bridge/.env
ExecStart=/home/team13/RasberryPI-Team-13/Challenge-III-Ice-Truck-Cloud/Code/cloud-bridge/venv/bin/python /home/team13/RasberryPI-Team-13/Challenge-III-Ice-Truck-Cloud/Code/cloud-bridge/bridge.py
Restart=on-failure
RestartSec=10
# Haertung: Dienst darf keine zusaetzlichen Rechte erlangen, eigenes /tmp
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
