# Kopieren nach .env (liegt nur auf dem Pi, NIE committen), dann: chmod 600 .env

# azure (Standard) oder thingspeak (Plan B ohne Azure, siehe README)
CLOUD_BACKEND=azure

# --- nur fuer CLOUD_BACKEND=thingspeak ---
# Channel ID + Write API Key aus ThingSpeak -> Channel -> "API Keys"
# Fuer ThingSpeak ausserdem unten setzen: MAX_MESSAGES_PER_CYCLE=1, MAX_ROWS_PER_MESSAGE=720
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=
# nur jede 3. Messung hochladen (5 s * 3 = 15 s, passt ins Free-Kontingent)
THINGSPEAK_DOWNSAMPLE=3

# --- nur fuer CLOUD_BACKEND=azure ---
# Device-Connection-String aus:
#   az iot hub device-identity connection-string show -n <hub-name> -d icetruck-team13-1 -o tsv
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<hub-name>.azure-devices.net;DeviceId=icetruck-team13-1;SharedAccessKey=<key>
TRUCK_ID=icetruck-team13-1
# 1 = MQTT ueber WebSockets (Port 443), falls ein Netz Port 8883 blockt
IOTHUB_WEBSOCKETS=0
SEND_INTERVAL_SECONDS=60
MAX_ROWS_PER_MESSAGE=60
MAX_MESSAGES_PER_CYCLE=5
# now = beim ersten Start nur neue Messungen, all = kompletten Bestand nachladen
START_FROM=now
ALARM_TEMP_C=28.0
SENSOR_MISMATCH_C=3.0
