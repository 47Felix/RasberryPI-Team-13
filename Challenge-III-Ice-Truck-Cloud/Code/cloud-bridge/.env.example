# Kopieren nach .env (liegt nur auf dem Pi, NIE committen), dann: chmod 600 .env
# Keys und Connection-Strings gehoeren nur in diese Datei, nicht in Chats, Folien oder Git.

# thingspeak (laeuft bei uns) oder azure (Plan A, siehe README)
CLOUD_BACKEND=thingspeak

# --- ThingSpeak ---
# Channel ID + Write API Key aus ThingSpeak -> Channel -> "API Keys"
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=
# 1 = jede 5-s-Messung hochladen (17.280/Tag, Jahreskontingent nach ca. 6 Monaten voll)
# 3 = nur jede 3. Messung (15-s-Raster, 5.760/Tag, Kontingent reicht ein ganzes Jahr)
THINGSPEAK_DOWNSAMPLE=1
# Pro Zyklus genau ein Upload (ThingSpeak Free: hoechstens ein Request alle 15 s)
MAX_MESSAGES_PER_CYCLE=1
MAX_ROWS_PER_MESSAGE=720
# 15 s bei DOWNSAMPLE=1 (kleine Pakete, nahe an Echtzeit), 60 s bei DOWNSAMPLE=3
SEND_INTERVAL_SECONDS=15

# --- Azure IoT Hub (nur fuer CLOUD_BACKEND=azure) ---
# Device-Connection-String aus:
#   az iot hub device-identity connection-string show -n <hub-name> -d icetruck-team13-1 -o tsv
IOTHUB_DEVICE_CONNECTION_STRING=
# 1 = MQTT ueber WebSockets (Port 443), falls ein Netz Port 8883 blockt
IOTHUB_WEBSOCKETS=0

# --- gemeinsam ---
TRUCK_ID=icetruck-team13-1
# now = beim ersten Start nur neue Messungen, all = kompletten Bestand nachladen
START_FROM=now
ALARM_TEMP_C=28.0
SENSOR_MISMATCH_C=3.0
