# Obsidian: persönlicher Workspace-Zustand (Fenster/Tabs) nicht versionieren,
# damit nicht bei jedem Öffnen unnötiger Git-Lärm entsteht.
ObsidianGehirn/.obsidian/workspace.json
ObsidianGehirn/.obsidian/workspace-mobile.json
ObsidianGehirn/.obsidian/graph.json

# Claudian: lokale Chat-/Conversation-Dateien - ändern sich staendig, nicht relevant fuers Repo
ObsidianGehirn/.claudian/sessions/

# Lokale Signing-Keys fuer signierte/verifizierte Commits (Claude) - NIEMALS committen!
.claude-secrets/

# Obsidian-Plugin-Konfigurationen koennen API-Keys/Zertifikate/private Schluessel
# enthalten (z.B. obsidian-local-rest-api: apiKey + TLS privateKey) - NIEMALS committen!
ObsidianGehirn/.obsidian/plugins/*/data.json

# Pi-Dashboard: Laufzeit-Artefakte (venv, SQLite-DB, .env mit Admin-Passwort/Discord-Token)
# leben nur auf dem Pi, nie committen
Code/pi-dashboard/venv/
Code/pi-dashboard/tresor.db
Code/pi-dashboard/.env

# Feed-Diversity-Prototyp: lokale venv/Cache, nie committen
Code/feed-diversity-prototype/venv/
Code/feed-diversity-prototype/**/__pycache__/
Code/feed-diversity-prototype/.pytest_cache/
